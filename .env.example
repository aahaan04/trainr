# Copy to .env.local for local dev. In Vercel these go under Settings > Environment
# Variables instead. See docs/DEPLOYMENT.md section 3 for what each one does.

# Supabase project URL. Settings -> API -> Project URL.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon/public key. Settings -> API -> Project API keys -> anon public.
# This is PUBLIC by design, never the service_role key.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Shared passphrase for the access gate. Leave unset to leave the gate open (dev).
VITE_ACCESS_PASSPHRASE=

# 'supabase' or 'local'. Omit to use the default: supabase in production, local in dev.
VITE_SIGNALING_TRANSPORT=
